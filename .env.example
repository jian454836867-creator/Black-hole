# Black hole — 环境变量示例
# 复制为 .env 后填入自己的值：copy .env.example .env

# ---- 模型源（国内加速，可选）----
# HuggingFace 官方站在国内常超时，走镜像。不改也能跑（会慢或超时）
HF_ENDPOINT=https://hf-mirror.com

# ---- 本地模型缓存目录 ----
TRANSFORMERS_CACHE=data/model-cache

# ---- DeepSeek API（可选）----
# 不填也能用：观点提取降级为按句切分，问答降级为本地词条直出并标注「未触网」
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 模型名（可选，默认如下）----
# deepseek-flash = V4.1 Flash（最便宜，日常提取/问答）
# deepseek-v4-pro = V4-Pro（深度推理，仅 deep=true 提问时用）
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ---- Claim 抽取方式（可选）----
# 默认纯规则抽取（零 API 消耗，每条入库只调 1 次 Flash 做观点提取）
# 设为 llm 则额外调一次 Flash 做结构化 claim 抽取，精度更高、成本翻倍
# CLAIM_EXTRACT=llm

# ---- 本地 API 端口（可选）----
PORT=7700
